[MASTER]

# Every disable below is a pattern this codebase uses deliberately, not a
# finding waved through. The gate exists for real defects; a rule the code
# structurally cannot satisfy is the one that trains people to ignore output.
[MESSAGES CONTROL]
disable=
    line-too-long,
    missing-function-docstring,
    missing-module-docstring,
    missing-class-docstring,
    unused-argument,
    import-error,
    invalid-name,
    broad-exception-caught,
    broad-exception-raised,
    global-statement,
# The stdlib suites load the module by file path after prepending their own
# helper directory, and deliberately exercise private normalization/formatting
# helpers: those are the extraction's behavior surface, not client misuse.
    wrong-import-position,
    protected-access,
# The Codex app-server process has an explicit terminate/kill/wait lifecycle in
# a finally block; wrapping it in `with Popen(...)` would obscure that cleanup.
    consider-using-with,
# query.py formats Codex RPC errors and compact window labels with % throughout,
# deliberately and consistently. Converting those format expressions to
# f-strings just to satisfy a preference would leave the module with two
# formatting dialects for equivalent provider labels.
    consider-using-f-string,
# The provider adapters deliberately keep their own payload normalization paths
# -- each provider must be readable and changeable without regard to the others.
# They land on the same idioms for argument parsing and table emission, and that
# repetition is the price of the independent API contracts, not an oversight.
    duplicate-code,
# These are single-file command-line tools: a helper's parameter naming a
# module-level constant is how they are written, not a shadowing accident.
    redefined-outer-name,
# Size and branch metrics. These functions are long because a provider payload's
# cases belong together; splitting them to satisfy a counter would make the
# normalization harder to verify against, not easier.
    too-many-lines,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    too-many-nested-blocks,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    too-many-public-methods,
    too-many-boolean-expressions,
# Layout preferences on branches that read as a table of cases.
    no-else-return,
    consider-using-in,
    consider-using-enumerate,
# `x == []` in a suite asserts the value is an empty LIST, not merely falsy.
# The suggested `not x` would also accept None, 0 and "" -- a weaker test.
    use-implicit-booleaness-not-comparison
max-attributes=30
max-args=10
max-positional-arguments=10
min-similarity-lines=15
